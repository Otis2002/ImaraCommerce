# Auto detect text files and normalize line endings to LF
* text=auto

# Text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Documents
*.pdf binary
*.docx binary
*.xlsx binary

# Archives
*.zip binary
*.tar binary
*.gz binary
